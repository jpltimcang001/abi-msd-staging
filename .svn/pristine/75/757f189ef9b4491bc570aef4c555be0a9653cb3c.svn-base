                        $msd_data_val->setMSD($att_key, $att_value);
                    }
                    $msd_data_val->added_by = DownloadConnector::MSD_LOGGER_NAME;
                    $msd_data_val->updated_by = DownloadConnector::MSD_LOGGER_NAME;
                    $msd_data_val->msd_synced = 1;
                    $msd_data[] = $msd_data_val;
                }
            } else {
