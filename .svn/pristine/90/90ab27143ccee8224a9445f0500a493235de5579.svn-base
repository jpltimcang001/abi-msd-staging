    /** 
     * Run Distribution Channel then Customer sync in one request
     * (16/06/2022)
     * 
     * @param 
     * 
     * @return void
     * */
    public function runChannelCustomer()
    {
        $data = json_decode($this->argument('data'), true);
        $sales_office_no = isset($data['sales_office_no']) ? $data['sales_office_no'] : "";
        $added_by = isset($data['added_by']) ? $data['added_by'] : "";
        $params_l =  [
            'company' => $data['company'],
            'sales_office_no' => isset($data['sales_office_no']) ? $data['sales_office_no'] : "",
            'added_by' => isset($data['added_by']) ? $data['added_by'] : "",
            'params' => [
                'Global_Dimension_1_Code' => isset($data['params']['Global_Dimension_1_Code']) ? $data['params']['Global_Dimension_1_Code'] : "",
                'Salesperson_Code' => isset($data['params']['Salesperson_Code']) ? $data['params']['Salesperson_Code'] : "",
                'No' =>  isset($data['params']['No']) ? $data['params']['No'] : "",
            ]
        ];
        $params_d =  [
            'company' => $data['company'],
            'sales_office_no' => isset($data['sales_office_no']) ? $data['sales_office_no'] : "",
            'added_by' => isset($data['added_by']) ? $data['added_by'] : "",
            'params' => [
                'WIN_Code' => isset($data['params']['WIN_Code']) ? $data['params']['WIN_Code'] : "",
            ]
        ];

        try {
            $trigger = Utils::saveTrigger($sales_office_no, APICommandHandler::COMBINED_CUSTOMER_NAME, DownloadConnector::STATUS_PENDING, $added_by);
            $trigger_id = isset($trigger['id']) ? $trigger['id'] : 0;
            Utils::saveLog($trigger_id, $sales_office_no, date("Y-m-d H:i:s"), DownloadConnector::INFO, DownloadConnector::MSD_LOGGER_NAME, "Started retrieve " . strtolower(APICommandHandler::COMBINED_CUSTOMER_NAME) . " maintenance.", ""); /* Save log message */

            print_r("[" . date("Y-m-d H:i:s") . "] Syncing " . strtolower(DistributionChannelData::MODULE_NAME_DISTRIBUTION_CHANNEL) . "\n");
            $this->runDistributionChannel($params_d);
            print_r("[" . date("Y-m-d H:i:s") . "] Syncing " . strtolower(LocationData::MODULE_NAME_LOCATION) . "\n");
            $this->runCustomer($params_l);

            Utils::saveLog($trigger_id, $sales_office_no, date("Y-m-d H:i:s"), DownloadConnector::INFO, DownloadConnector::MSD_LOGGER_NAME, "Done retrieved " . strtolower(APICommandHandler::COMBINED_CUSTOMER_NAME) . " maintenance.", ""); /* Save log message */
            Utils::updateTriggerStatus($trigger_id, DownloadConnector::STATUS_DONE); /* Update trigger status */
            Utils::updateTriggerEndDate($trigger_id, date("Y-m-d H:i:s")); /* Update trigger end date */
        } catch (\Exception $exc) {
            throw $exc;
        }
    }

    /** 
     * Run Zone, Salesman Type, Salesman then Stock in Salesman Warehouse sync in one request
     * (16/06/2022)
     * 
     * @return void
     * */
    public function runStocksMultiple()
    {
        $data = json_decode($this->argument('data'), true);
        $sales_office_no = isset($data['sales_office_no']) ? $data['sales_office_no'] : "";
        $added_by = isset($data['added_by']) ? $data['added_by'] : "";
        $data_l =  [
            'company' => $data['company'],
            'sales_office_no' => isset($data['sales_office_no']) ? $data['sales_office_no'] : "",
            'added_by' => isset($data['added_by']) ? $data['added_by'] : "",
            'params' => [
                'zone_code' => isset($data['params']['zone_code']) ? $data['params']['zone_code'] : "",
            ]
        ];
        $data_st =  [
            'company' => $data['company'],
            'sales_office_no' => isset($data['sales_office_no']) ? $data['sales_office_no'] : "",
            'added_by' => isset($data['added_by']) ? $data['added_by'] : "",
            'params' => [
                'WIN_Code' => isset($data['params']['WIN_Code']) ? $data['params']['WIN_Code'] : "",
            ]
        ];
        $data_sm =  [
            'company' => $data['company'],
            'sales_office_no' => isset($data['sales_office_no']) ? $data['sales_office_no'] : "",
            'added_by' => isset($data['added_by']) ? $data['added_by'] : "",
            'params' => [
                'Code' => isset($data['params']['Code']) ? $data['params']['Code'] : "",
            ]
        ];
        $data_sw =  [
            'company' => $data['company'],
            'sales_office_no' => isset($data['sales_office_no']) ? $data['sales_office_no'] : "",
            'added_by' => isset($data['added_by']) ? $data['added_by'] : "",
            'params' => [
                'Location_Code' => isset($data['params']['Location_Code']) ? $data['params']['Location_Code'] : "",
            ]
        ];

        try {
            $trigger = Utils::saveTrigger($sales_office_no, APICommandHandler::COMBINED_STOCK_IN_SALESMAN, DownloadConnector::STATUS_PENDING, $added_by);
            $trigger_id = isset($trigger['id']) ? $trigger['id'] : 0;
            Utils::saveLog($trigger_id, $sales_office_no, date("Y-m-d H:i:s"), DownloadConnector::INFO, DownloadConnector::MSD_LOGGER_NAME, "Started retrieve " . strtolower(APICommandHandler::COMBINED_STOCK_IN_SALESMAN) . " maintenance.", ""); /* Save log message */

            print_r("[" . date("Y-m-d H:i:s") . "] Syncing " . strtolower(LocationData::MODULE_NAME_LOCATION) . "\n");
            $this->runLocation($data_l);
            print_r("[" . date("Y-m-d H:i:s") . "] Syncing " . strtolower(SalesmanTypeData::MODULE_NAME_SALESMAN_TYPE) . "\n");
            $this->runSalesmanType($data_st);
            print_r("[" . date("Y-m-d H:i:s") . "] Syncing " . strtolower(SalesmanData::MODULE_NAME_SALESMAN) . "\n");
            $this->runSalesman($data_sm);
            print_r("[" . date("Y-m-d H:i:s") . "] Syncing " . strtolower(InventoryData::MODULE_INVENTORY) . "\n");
            $this->runStockInSalesmanWarehouse($data_sw);

            Utils::saveLog($trigger_id, $sales_office_no, date("Y-m-d H:i:s"), DownloadConnector::INFO, DownloadConnector::MSD_LOGGER_NAME, "Done retrieved " . strtolower(APICommandHandler::COMBINED_STOCK_IN_SALESMAN) . " maintenance.", ""); /* Save log message */
            Utils::updateTriggerStatus($trigger_id, DownloadConnector::STATUS_DONE); /* Update trigger status */
            Utils::updateTriggerEndDate($trigger_id, date("Y-m-d H:i:s")); /* Update trigger end date */
        } catch (\Exception $exc) {
            throw $exc;
        }
    }

