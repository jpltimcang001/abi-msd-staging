    /**
     * Takes data from NOC and sends it to client REST API.
     * (06/04/2022)
     * 
     * @param method HTTP request type for REST API.
     * @param url URL for REST API.
     * @param data HTTP data from NOC request
     * @param trigger_id ID for request trigger log
     * 
     * @return void
     */
    public static function syncCashReceiptJournal($method, $url, $data, $trigger_id = null)
    {
        $params = [];
        $params['date_from'] = isset($data['date_from']) ? $data['date_from'] : date("Y-m-d");
        $params['date_to'] = isset($data['date_to']) ? $data['date_to'] : date("Y-m-d");
        $noc_data = ReceiptJournalForm::getCashReceiptJournalData($params);
        $total_rows = count($noc_data);
        $file_name = UploadConnector::PATH . ($trigger_id != null ? $trigger_id . "-" : "") . date("YmdHis-") . str_replace(" ", "-", UploadConnector::MODULE_CASH_RECEIPT_JOURNAL);

        Utils::updateTriggerTotalRows($trigger_id, $total_rows); /* Update trigger total rows */
        Utils::updateTriggerStatus($trigger_id, UploadConnector::STATUS_ONGOING); /* Update trigger status */

        /* Sync Cash Receipt Journal by batch thru MSD API */
        if ($total_rows > 0) {
            $batch_data = array_chunk($noc_data, UploadConnector::BATCH_LIMIT); // Create batch

            foreach ($batch_data as $key => $batch) {

                $batch_params = [];
                foreach ($batch as $line) {
                    $line = get_object_vars($line);
                    array_push($batch_params, [
                        "CurrentJnlBatchName" => $line['batch_name'],
                        "Line_No" => $line['line_no'],
                        "Posting_Date" => $line['posting_date'],
                        "Document_Date" => $line['document_date'],
                        "Document_Type" => $line['document_type'],
                        "Document_No" => $line['document_no'],
                        "External_Document_No" => $line['external_document_no'],
                        "Account_Type" => $line['account_type'],
                        "Account_No" => $line['account_no'],
                        "Outlet_Name" => $line['location_name'],
                        "Salespers_Purch_Code" => $line['salesman_code'],
                        "Payment_Method_Code" => $line['payment_method_code'],
                        "Amount" => $line['amount'],
                        "Comment" => $line['comments'],
                        "Bal_Account_Type" => $line['bal_account_type'],
                        "Bal_Account_No" => $line['bal_account_no'],
                        "Customer_Vendor_Bank" => $line['location_bank'],
                        "Check_No" => $line['check_no'],
                        "Check_Date" => $line['check_date'],
                        "Created_By" => $line['created_by'],
                        "Creation_Date_and_Time" => $line['created_when'],
                    ]);
                }
                /* Save generated request as file backup */
                Globals::saveJsonFile($file_name . "-" . ($key + 1), $batch_params);
                /* MS Dynamics API */
                $rest_result = Globals::callRESTAPI($method, $url, json_encode($batch_params));
                if ($key === 0) {
                    Utils::updateTriggerTotalRows($trigger_id, count($batch_params)); /* Update trigger total rows */
                } else {
                    Utils::updateTriggerTotalRows($trigger_id, count($batch_params), true); /* Update trigger total rows = existing + response total_rows */
                }
            }
        }
    }

